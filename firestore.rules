rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    match /{col}/{id} {
      allow read: if col != 'messages';
      allow write: if isAdmin() && col != 'messages';
    }

    match /messages/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'email', 'phone', 'company', 'area', 'subject', 'message', 'read', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 160
        && request.resource.data.message is string && request.resource.data.message.size() <= 5000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
    }
  }
}
